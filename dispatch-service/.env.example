POSTGRESQL_URL=postgresql+psycopg://{username}:{password}@localhost:5432/{db_name}
REDIS_URL=redis://:{password}@localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Must match order-service's KAFKA_ORDER_EVENTS_TOPIC.
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_DISPATCH_EVENTS_TOPIC=dispatch-events

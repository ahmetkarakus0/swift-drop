USER_SERVICE_URL=http://127.0.0.1:8000
RESTAURANT_SERVICE_URL=http://127.0.0.1:8001
GATEWAY_URL=http://127.0.0.1:8080
HTTP_TIMEOUT_SECONDS=10

USER_DB_URL=postgresql+psycopg://user_service:user_service@localhost:5432/user_db
RESTAURANT_DB_URL=postgresql+psycopg://restaurant_service:restaurant_service@localhost:5432/restaurant_db
REDIS_URL=redis://:redis@localhost:6379/0

# Every record created by the tests (user emails, restaurant/category/item names) starts with
# this prefix; cleanup deletes everything that starts with it from each database.
TEST_DATA_PREFIX=e2e_test
TEST_EMAIL_DOMAIN=e2e.swiftdrop.test
DEFAULT_PASSWORD=Password123!

# Set to true to keep test data in the databases after the run (useful for debugging).
KEEP_TEST_DATA=false
